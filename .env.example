# Copiá este archivo a .env.local y completá con los datos de tu proyecto de Supabase
# (Dashboard → Project Settings → API). Nunca subas .env.local al repositorio.

# URL del proyecto: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable (sb_publishable_...) o, en proyectos anteriores, la "anon key".
# Es pública por diseño: la seguridad la dan las políticas RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública del sitio (links de invitación y emails). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NO uses la service_role key en esta app: no hace falta y no debe estar en el frontend.
